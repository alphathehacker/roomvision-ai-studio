# RoomVision AI Studio backend — example environment.
# Copy to .env and fill in real values. NEVER commit a real .env.
# All values here are placeholders, not real credentials.

# --- Server ---
PORT=5000

# --- Database (Phase 1: SQLite) ---
# Option A: sqlite URL (wins if set)
DATABASE_URL=
# Option B: plain path to the SQLite file
SQLITE_PATH=roomvision.db

# --- Uploads ---
UPLOAD_DIR=uploads
# Max size per uploaded image, in megabytes
MAX_UPLOAD_MB=15

# --- AI provider (Phase 3 slot; leave empty for the honest 503 default) ---
# e.g. replicate | openai | custom
AI_PROVIDER=
AI_API_KEY=
AI_API_URL=

# --- CORS ---
# Comma-separated origins, or * for development
FRONTEND_ORIGIN=*
