# RoomVision AI Studio backend — example environment.
# Copy to .env and fill in real values. NEVER commit a real .env.
# All values here are placeholders, not real credentials.

# --- Server ---
PORT=5000

# --- Database (Phase 1: SQLite) ---
# Option A: sqlite URL (wins if set)
DATABASE_URL=
# Option B: plain path to the SQLite file
SQLITE_PATH=roomvision.db

# --- Uploads ---
UPLOAD_DIR=uploads
# Max size per uploaded image, in megabytes
MAX_UPLOAD_MB=15

# --- AI provider (leave empty for the honest 503 default) ---
# Supported: huggingface  (room segmentation via HF Inference API)
AI_PROVIDER=
AI_API_KEY=
AI_API_URL=

# --- Hugging Face provider ---
# Free token from https://huggingface.co/settings/tokens (no card needed).
# AI_API_KEY is accepted as a fallback if HF_TOKEN is unset.
HF_TOKEN=
# Segmentation model override (default: SegFormer-b2 fine-tuned on ADE20K,
# whose labels include wall / floor / ceiling / window / door).
HF_SEG_MODEL=
# Inference endpoint override (default: https://api-inference.huggingface.co/models)
HF_API_URL=

# --- CORS ---
# Comma-separated origins, or * for development
FRONTEND_ORIGIN=*
